    "name" : "Alice",            # string key , string value
    42: [1,2,3],                  # int key, list value
    (10,20) : {"nested" : True}   # tuple key , dict value
}

print(type(user_data),"valid dict")

try:
    invalid_dict = {[1,2] : "value"} # Lists are not hashable
except TypeError as e:
    print(f"Error: {e}")

